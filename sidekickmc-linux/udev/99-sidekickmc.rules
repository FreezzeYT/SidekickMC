# /etc/udev/rules.d/99-sidekickmc.rules
# Grants the active desktop user and the 'input' group access to /dev/uinput and /dev/input/event*
KERNEL=="uinput", SUBSYSTEM=="misc", TAG+="uaccess", MODE="0660", GROUP="input"
KERNEL=="event*", SUBSYSTEM=="input", TAG+="uaccess", MODE="0660", GROUP="input"
